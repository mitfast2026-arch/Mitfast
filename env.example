# MITFAST Environment Variables Template
# Copy this file to .env.local for local development.
# Do NOT commit production credentials or .env.local to version control.

# ── Supabase Configuration ──────────────────────────────────────────────────
# Required for client-side and server-side Supabase connections.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site & Domain ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email Delivery (Transactional & OTP) ─────────────────────────────────────
# Priority order: SMTP (Direct) -> Brevo -> Resend
EMAIL_FROM=MITFAST <noreply@example.com>

# SMTP Configuration (Optional if Brevo or Resend configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Brevo API (Optional)
BREVO_API_KEY=

# Resend API (Optional)
RESEND_API_KEY=

# Supabase Auth Email Webhook Hook Secret (Optional, for edge function hook)
SEND_EMAIL_HOOK_SECRET=

# ── Tigris / S3-compatible Object Storage ────────────────────────────────────
# Used for product documents, enquiry attachments, and media uploads.
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET_NAME=
TIGRIS_STORAGE_URL=

# ── AI Services (Groq) ───────────────────────────────────────────────────────
# Used for AI product description refinement.
GROQ_API_KEY=

# ── Application Modes & Guards ──────────────────────────────────────────────
# Set to 'false' or omit in production.
NEXT_PUBLIC_ENABLE_TEST_PROBES=false
ALLOW_UNSAFE_DB_FALLBACK=false
